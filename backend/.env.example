# PostgreSQL — get this from Neon.tech dashboard after creating a project
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HuggingFace (add when you get to Phase 2)
HF_API_TOKEN=your-huggingface-token
HF_MODEL_URL=https://api-inference.huggingface.co/models/your-chosen-model

# CORS — your frontend URL(s). Comma-separate multiple, e.g. for local + deployed:
# FRONTEND_ORIGIN=http://localhost:3000,https://verifinews.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
